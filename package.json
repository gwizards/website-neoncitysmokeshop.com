{
  "name": "neon-city-support-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/finalize.mjs",
    "check": "astro check && tsc --noEmit -p tsconfig.worker.json",
    "types": "wrangler types",
    "test": "vitest run",
    "audit": "node scripts/audit.mjs",
    "cf:check": "wrangler deploy --dry-run",
    "quality": "npm run check && npm test && npm run build && npm run audit && npm run cf:check"
  },
  "dependencies": {
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.132.0"
  }
}
