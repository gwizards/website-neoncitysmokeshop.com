---
import Layout from '../../layouts/Layout.astro';
import posts from '../../data/blog.json';
import { site } from '../../../shared/site';
const formatDate = (value: string) => new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(new Date(`${value}T12:00:00Z`));
const blogSchema = {
  '@type': 'CollectionPage',
  '@id': `${site.origin}/blog/#page`,
  name: 'Neon City Smoking and Vaping Guides',
  description: 'Guides about pipes, cigars, hookahs, vaping, e-cigarettes, and smoking-accessory care.',
  isPartOf: { '@id': `${site.origin}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: posts.map((post, index) => ({ '@type': 'ListItem', position: index + 1, url: new URL(`/${post.slug}/`, site.origin).href, name: post.title })),
  },
};
---
<Layout title="Neon City | Smoking and Vaping Guides" description="Read Neon City guides about pipes, cigars, hookahs, vaping, e-cigarettes, and smoking-accessory care." schema={blogSchema}>
  <section class="page-hero"><div class="shell"><p class="eyebrow">Neon City blog</p><h1>Journey into the vaping universe</h1><p>Explore practical guides, product-care tips, and introductory information about pipes, cigars, hookahs, vaping, and smoking accessories.</p></div></section>
  <section class="blog-index"><div class="shell blog-grid">
    {posts.map(post => <article class="blog-card">
      <a class="blog-card-image" href={`/${post.slug}/`}><img src={post.image} width="960" height="640" loading="lazy" alt={post.imageAlt} /></a>
      <div class="blog-card-copy"><p class="blog-meta"><span>Blog</span> · <time datetime={post.date}>{formatDate(post.date)}</time></p><h2><a href={`/${post.slug}/`}>{post.title}</a></h2><p>{post.description}</p><a class="blog-read" href={`/${post.slug}/`}>Read article <span aria-hidden="true">›</span></a></div>
    </article>)}
  </div></section>
</Layout>
