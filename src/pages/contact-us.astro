---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
---
<Layout title="Neon City | Contact Us" description="Contact Neon City Smoke Shop in Las Vegas by phone, email, social media, or the protected contact form.">
  <section class="page-hero"><div class="shell"><p class="eyebrow">Contact us</p><h1>Neon City: for adults 21+</h1><p>Visit the shop, call, email, or use the protected form for administrative and website questions.</p></div></section>
  <section class="contact-facts"><div class="shell fact-grid"><article><h2>Visit</h2><p>7175 W Lake Mead Blvd #162<br />Las Vegas, NV 89128</p><a href="https://maps.app.goo.gl/NhAz5iJgZurPDRQs7" target="_blank" rel="noopener noreferrer">Get directions</a></article><article><h2>Call or email</h2><p><a href="tel:+17252931435">725-293-1435</a><br /><a href="mailto:neoncitysmokeshop@gmail.com">neoncitysmokeshop@gmail.com</a></p></article><article><h2>Hours</h2><p>Mon–Thu: 10am–8pm<br />Fri–Sat: 10am–9pm<br />Sun: 10am–7pm</p></article></div></section>
  <ContactForm heading="Send the team a message" intro="Use the protected form for administrative, accessibility, privacy, or website feedback. For product availability, call or email the public shop contact." />
</Layout>
