---
import '../styles/site.css';
import AgeGate from '../components/AgeGate.astro';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#ca06b5" />
    <link rel="preload" href="/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <AgeGate />
    <a class="skip" href="#main">Skip to content</a>
    <div class="preview"><span class="preview-source">Anybody who’s 21+ and enjoys smoking a cigarette, or perhaps something more relaxing</span><span class="preview-note">Development preview</span></div>
    <header><div class="shell header-inner"><a class="brand" href="/" aria-label="Neon City home"><img src="/images/neon-city-header-logo.webp" width="250" height="98" alt="Neon City Smoke Shop" /></a><nav aria-label="Main navigation"><a href="/#about">About</a><a href="/#information">Products &amp; services</a><a href="/#location">Location</a><a href="https://neoncitysmokeshop.com/blog/">Blog</a><a class="header-contact" href="/#support">Contact us</a></nav></div></header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer id="location"><div class="shell footer-inner"><a class="footer-brand" href="/" aria-label="Neon City home"><img src="/images/neon-city-full-logo.webp" width="1080" height="471" alt="Neon City Smoke Shop" /></a><div><h2>Main menu</h2><a href="/">Home</a><a href="/#about">About us</a><a href="/#information">Products and services</a><a href="/#location">Location</a><a href="/#support">Contact us</a><a href="/privacy/">Privacy notice</a></div><div class="footer-contact"><h2>Contact</h2><a href="https://goo.gl/maps/NhAz5iJgZurPDRQs7" rel="noopener noreferrer"><span aria-hidden="true">⌖</span>7175 W Lake Mead #162 Las Vegas NV 89128</a><p><span aria-hidden="true">◷</span>Monday - Thursday: 10am - 8pm</p><p><span aria-hidden="true">◷</span>Friday - Saturday: 10am - 9pm</p><p><span aria-hidden="true">◷</span>Sunday: 10am - 7pm</p><a href="tel:+17252931435"><span aria-hidden="true">☎</span>7252931435</a><a href="mailto:neoncitysmokeshop@gmail.com"><span aria-hidden="true">✉</span>neoncitysmokeshop@gmail.com</a><a href="https://www.instagram.com/neoncitysmokeshop/" rel="noopener noreferrer"><span aria-hidden="true">◎</span>Neoncitysmokeshop</a><a href="https://www.tiktok.com/@neoncitysmokeshop" rel="noopener noreferrer"><span aria-hidden="true">♪</span>Neoncitysmokeshop</a></div></div><div class="shell footer-legal"><span>Copyright © 2023. All rights reserved.</span><span>Development preview · <a href="https://wizards.us/" rel="noopener noreferrer">Web Design by Global Wizards</a></span></div></footer>
  </body>
</html>
