---
import '../styles/site.css';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Neon City</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#ca06b5" />
    <link rel="preload" href="/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="preview"><span class="dot"></span> Development preview <span class="preview-note">· Support & information</span></div>
    <header><div class="shell header-inner"><a class="brand" href="/" aria-label="Neon City home"><img src="/images/neon-city-logo.webp" width="250" height="98" alt="Neon City" /></a><nav aria-label="Main navigation"><a href="/#about">About</a><a href="/#information">Information</a><a href="/privacy/">Privacy</a><a class="header-contact" href="/#support">Contact us</a></nav></div></header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer><div class="shell footer-inner"><a class="footer-brand" href="/" aria-label="Neon City home"><img src="/images/neon-city-logo.webp" width="250" height="98" alt="Neon City" /><span>Information. Accessibility. Support.</span></a><div><h2>Main menu</h2><a href="/">Home</a><a href="/#about">About this website</a><a href="/#support">Contact us</a></div><div><h2>Information</h2><a href="/#questions">Common questions</a><a href="/privacy/">Privacy notice</a><p>Development website · For testing</p></div></div></footer>
  </body>
</html>
