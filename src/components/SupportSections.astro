---
const cards = [
  { image: '/images/icon-hookahs.png', title: 'Hookahs', text: 'Explore our exquisite collection of hookahs.' },
  { image: '/images/icon-bongs.png', title: 'Bongs', text: 'Discover a variety of bongs.' },
  { image: '/images/icon-pipes.png', title: 'Pipes', text: 'Functional and stylish pipes.' },
  { image: '/images/icon-e-cigs.png', title: 'E-cigs', text: 'Explore the world of electronic cigarettes.' },
  { image: '/images/icon-vapes.png', title: 'Vapes', text: 'Find the perfect vape for your taste.' },
  { image: '/images/icon-additional.png', title: 'Additional', text: 'Browse through false lashes, sunglasses, jewelry, and more.' },
];
const production = import.meta.env.PUBLIC_DEPLOY_ENV === 'production';
---
<section id="information" class="information-section"><div class="shell"><h2>Diverse smoking essentials</h2><p class="age-section-note">For adults aged 21 and over. Category information only; this website does not process purchases{production ? ' directly' : ' in the development preview'}.</p><div class="support-grid"><div class="support-column">{cards.slice(0,3).map(card => <article class="support-card"><img src={card.image} width="96" height="96" alt="" loading="lazy" /><div><h3>{card.title}</h3><p>{card.text}</p></div></article>)}</div><div class="support-center"><div class="neon-frame source-photo"><picture><source srcset="/images/neon-city-essentials.avif" type="image/avif" /><img src="/images/neon-city-essentials.webp" width="800" height="1251" alt="Monochrome smoke portrait" loading="lazy" /></picture></div></div><div class="support-column">{cards.slice(3).map(card => <article class="support-card"><img src={card.image} width="96" height="96" alt="" loading="lazy" /><div><h3>{card.title}</h3><p>{card.text}</p></div></article>)}</div></div></div></section>
<section class="contact-banner" aria-labelledby="contact-banner-title">
  <video id="contact-video" class="contact-video" muted loop playsinline preload="none" poster="/video/original-colored-smoke-poster.webp" aria-hidden="true" tabindex="-1" data-src="/video/original-colored-smoke.mp4"></video>
  <div class="contact-banner-shade" aria-hidden="true"></div>
  <div class="shell contact-banner-content"><p class="eyebrow">Contact</p><h2 id="contact-banner-title">Elevate your experience</h2><p>Do you have any questions or comments? Feel free to get in touch with us. You can visit us at our Las Vegas location or contact us via email or phone. We’re also on Instagram to keep you updated on our latest offerings.</p><a class="button" href="#support">Contact us <span aria-hidden="true">›</span></a></div>
  <button id="contact-video-toggle" class="video-toggle contact-video-toggle" type="button" aria-controls="contact-video" hidden>Play contact background video</button>
</section>
<script src="../scripts/contact-video.ts"></script>
